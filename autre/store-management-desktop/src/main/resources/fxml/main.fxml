<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.store.presentation.controller.MainController"
            prefHeight="650" prefWidth="1000" style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: #2c3e50;">
            <Label text="Store Management" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;">
                <padding>
                    <Insets top="10" right="15" bottom="10" left="15"/>
                </padding>
            </Label>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Exit" onAction="#exit"/>
                </Menu>
                <Menu text="Data">
                    <MenuItem text="Dashboard" onAction="#showDashboard"/>
                    <MenuItem text="Products" onAction="#showProducts"/>
                    <MenuItem text="Customers" onAction="#showCustomers"/>
                    <MenuItem text="Suppliers" onAction="#showSuppliers"/>
                </Menu>
                <Menu text="Sales">
                    <MenuItem text="Invoices" onAction="#showInvoices"/>
                    <MenuItem text="Orders" onAction="#showSalesOrders"/>
                </Menu>
                <Menu text="Purchases">
                    <MenuItem text="Purchase Invoices" onAction="#showPurchases"/>
                    <MenuItem text="Purchase Orders" onAction="#showPurchaseOrders"/>
                </Menu>
            </MenuBar>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" minHeight="400">
            <!-- Content loaded dynamically -->
        </StackPane>
    </center>

    <bottom>
        <Label text="Store Management MVP v1.0 - JavaFX + H2" style="-fx-text-fill: gray; -fx-font-size: 11;">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
