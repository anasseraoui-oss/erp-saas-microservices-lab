<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.store.presentation.controller.DashboardController"
      spacing="20" style="-fx-background-color: #f4f7f6;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Store Overview" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <FlowPane hgap="25" vgap="25" prefWrapLength="800">
        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;" prefWidth="220">
            <Label text="Total Sales" style="-fx-text-fill: gray; -fx-font-size: 14;"/>
            <Label fx:id="salesLabel" text="0.00 DH" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;" prefWidth="220">
            <Label text="Total Purchases" style="-fx-text-fill: gray; -fx-font-size: 14;"/>
            <Label fx:id="purchasesLabel" text="0.00 DH" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;" prefWidth="220">
            <Label text="Estimated Profit" style="-fx-text-fill: gray; -fx-font-size: 14;"/>
            <Label fx:id="profitLabel" text="0.00 DH" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </VBox>

        <HBox spacing="20" prefWidth="710">
            <VBox spacing="10" style="-fx-background-color: #fff5f5; -fx-border-color: #feb2b2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                <Label text="Low Stock Alerts" style="-fx-font-weight: bold; -fx-text-fill: #c53030;"/>
                <Label fx:id="lowStockLabel" text="0 products need restock" style="-fx-font-size: 16;"/>
            </VBox>
            <VBox spacing="10" style="-fx-background-color: #fffaf0; -fx-border-color: #fbd38d; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                <Label text="Expiry Alerts" style="-fx-font-weight: bold; -fx-text-fill: #975a16;"/>
                <Label fx:id="expiredLabel" text="0 products expired" style="-fx-font-size: 16;"/>
            </VBox>
        </HBox>
    </FlowPane>

    <Label text="Navigation" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Use the top Menu Data to navigate between modules." style="-fx-text-fill: gray;"/>
</VBox>
