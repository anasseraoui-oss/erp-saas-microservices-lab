# Copy this file to .env and replace every placeholder before starting Docker Compose.
MYSQL_USER=pfel_app
MYSQL_PASSWORD=change-me-before-use
MYSQL_ROOT_PASSWORD=change-me-before-use
JWT_SECRET_KEY=replace-with-base64-encoded-256-bit-secret
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
REACT_APP_GATEWAY_URL=http://localhost:9055
